#compdef apple-container

_apple_container() {
  local -a subcmds
  subcmds=(
    'list:list containers'
    'build:build the image locally'
    'up:start the container mounting a workspace dir'
    'exec:attach to the running container (zsh)'
    'status:show container status'
    'logs:show container logs'
    'down:stop and delete the container'
    'doctor:check prerequisites'
    'pull:pull the image from GHCR'
  )

  if (( CURRENT == 2 )); then
    _describe 'subcommand' subcmds
    return
  fi

  case $words[2] in
    up)
      if [[ $words[CURRENT] == -* ]]; then
        _values 'option' \
          '--name[container name]' \
          '--no-pull[skip image pull]'
      else
        _files -/
      fi
      ;;
    exec|status|logs|down)
      if [[ $words[CURRENT] == -* ]]; then
        _values 'option' '--name[container name]'
      fi
      ;;
    logs)
      if [[ $words[CURRENT] == -* ]]; then
        _values 'option' '--name[container name]' '-f[follow log output]'
      fi
      ;;
  esac
}

_apple_container "$@"
