#!/bin/zsh

_ymt_teecopy_usage() {
  cat <<EOF
teecopy reads stdin, prints it to the terminal, and copies the output to the clipboard with ANSI escape sequences stripped.

Usage:
    <command> | teecopy

Examples:
    terraform plan | teecopy
    kubectl describe pod foo | teecopy

Options:
    --help, -h         print help

Dependencies:
    clip (or pbcopy / wl-copy / xclip via ~/.local/bin/clip)
EOF
}

_ymt_teecopy() {
  if ! command -v clip >/dev/null 2>&1; then
    echo "Error: clip command is not available (expected in ~/.local/bin/clip). Run: make link" >&2
    return 1
  fi
  tee >(sed $'s/\x1b\\[[0-9;]*m//g' | clip copy)
}

case ${1} in
  -h|--help)
    _ymt_teecopy_usage
  ;;

  '')
    _ymt_teecopy
  ;;

  *)
    _ymt_teecopy_usage >&2
    return 1
  ;;
esac
