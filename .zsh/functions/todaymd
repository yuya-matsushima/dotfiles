#!/bin/zsh

_ymt_todaymd_usage() {
  cat <<EOF
todaymd creates a markdown file with a date prefix in the specified directory, and makes it editable.

Usage:
    todaymd [options] [file name]
                      create markdown with CLI Editor
    todaymd list      list markdown files in TODAYMD_DIR
    todaymd edit      search and edit file with fzf
    todaymd rm        search and remove file with fzf

Options:
    -t, --type <type> frontmatter type (note, prompt, log, ...) [default: note]
    --help, -h        print help

Configurable Environment Variables:
  TODAYMD_DIR=path/to/default/save/dir

Frontmatter:
  A newly created file starts with an OKF-style YAML frontmatter block:

    ---
    type: <type>
    title: <file name>
    generated:
      by: human:<user>
      at: <ISO 8601 datetime>
    tags: []
    ---

Dependencies:
    fzf
    tmux
    nvim
EOF
}

_ymt_todaymd_frontmatter() {
  local type="$1"
  local title="$2"
  local author="human:$(whoami)"
  local created
  local escaped_title

  created="$(date '+%Y-%m-%dT%H:%M:%S%z' | sed -E 's/([+-][0-9]{2})([0-9]{2})$/\1:\2/')"
  escaped_title="$(printf '%s' "$title" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g')"

  echo "---"
  echo "type: ${type}"
  echo "title: \"${escaped_title}\""
  echo "generated:"
  echo "  by: ${author}"
  echo "  at: ${created}"
  echo "tags: []"
  echo "---"
  echo ""
  echo "# ${title}"
}

_ymt_todaymd() {
  local filename file_path dir entered_dir create type
  local default_dir=$(pwd)
  type="note"

  while [[ $# -gt 0 ]]; do
    case "$1" in
      -t|--type)
        if [[ -z "$2" ]]; then
          echo "Error: option '$1' requires a type" >&2
          return 1
        fi
        type="$2"
        shift 2
        ;;
      --type=*)
        type="${1#--type=}"
        shift
        ;;
      -h|--help)
        _ymt_todaymd_usage
        return
        ;;
      --)
        shift
        break
        ;;
      -*)
        echo "Error: Unknown option '$1'" >&2
        echo "Run 'todaymd --help' for usage." >&2
        return 1
        ;;
      *)
        break
        ;;
    esac
  done

  if [[ -z "$type" ]]; then
    echo "Error: type must not be empty" >&2
    return 1
  fi

  if [ -n "${TODAYMD_DIR}" ]; then
    default_dir=${TODAYMD_DIR}
  fi

  filename="$*"
  if [[ -z "${filename}" ]]; then
    read -r filename\?"Enter a file name: "
  fi
  read -r entered_dir\?"Enter the directory(${default_dir}): "

  dir="${entered_dir:-${default_dir}}"
  file_path="${dir}/$(date '+%Y%m%d')_$(echo "$filename" | sed -e 's/\s\+/_/g').md"

  if [[ ! -d "$dir" ]]; then
    read -r -k 1 create\?"There is no directory: ${dir}. Do you want to create it?(y/n): "
    if [[ "$create" != 'y' ]]; then
      echo "\nStopped creating the file."
      return
    fi

    echo "\nCreating a directory: ${dir}"
    mkdir -p "$dir"
  fi

  if [[ ! -f "$file_path" ]]; then
    echo "Create a markdown file: ${file_path}"
    _ymt_todaymd_frontmatter "$type" "$filename" > "$file_path"
  fi

  if ! command -v nvim >/dev/null 2>&1; then
    echo "Error: nvim is not installed" >&2
    return 1
  fi
  nvim "$file_path"
}

_ymt_todaymd_type() {
  local type
  type="$(sed -n '1,20p' "$1" | awk '
    NR == 1 && $0 == "---" { fm = 1; next }
    fm && $0 == "---" { exit }
    fm && /^type:[[:space:]]/ { sub(/^type:[[:space:]]*/, ""); sub(/[[:space:]]+$/, ""); print; exit }
  ')"
  if [[ -z "$type" ]]; then
    printf '%s\n' "-"
  else
    printf '%s\n' "$type"
  fi
}

_ymt_todaymd_list() {
  if [ -z "${TODAYMD_DIR}" ]; then
    echo "TODAYMD_DIR is not set."
    return 1
  fi

  find "${TODAYMD_DIR}" -name \*.md -type f | while read -r f; do
    printf '%-14s %s\n' "$(_ymt_todaymd_type "$f")" "$(basename "$f")"
  done | sort -r -k2
}

_ymt_todaymd_edit() {
  local file line

  if [ -z "${TODAYMD_DIR}" ]; then
    echo "TODAYMD_DIR is not set."
    return 1
  fi

  line=$(find "${TODAYMD_DIR}" -name \*.md -type f | while read -r f; do
    printf '%-14s %s\n' "$(_ymt_todaymd_type "$f")" "$(basename "$f")"
  done | sort -r -k2 | fzf --prompt='file >')
  if [[ -n "$line" ]]; then
    file="${line##* }"
    if ! command -v nvim >/dev/null 2>&1; then
      echo "Error: nvim is not installed" >&2
      return 1
    fi
    nvim "${TODAYMD_DIR}/${file}"
  fi
}

_ymt_todaymd_rm() {
  local file line

  if [ -z "${TODAYMD_DIR}" ]; then
    echo "TODAYMD_DIR is not set."
    return 1
  fi

  line=$(find "${TODAYMD_DIR}" -name \*.md -type f | while read -r f; do
    printf '%-14s %s\n' "$(_ymt_todaymd_type "$f")" "$(basename "$f")"
  done | sort -r -k2 | fzf --prompt='file >')
  if [[ -n "$line" ]]; then
    file="${line##* }"
    rm -i "${TODAYMD_DIR}/${file}"
  fi
}

case ${1} in
  -h|--help)
    _ymt_todaymd_usage
  ;;

  list)
    _ymt_todaymd_list
  ;;

  edit)
    _ymt_todaymd_edit
  ;;

  rm)
    _ymt_todaymd_rm
  ;;

  *)
    _ymt_todaymd "$@"
  ;;
esac
