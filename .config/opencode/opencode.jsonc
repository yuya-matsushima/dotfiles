{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode-go/deepseek-v4-flash",
  "small_model": "opencode-go/glm-5.3-flash",
  "lsp": false,
  "autoupdate": false,
  "enabled_providers": [
    "opencode-go",
    "opencode"
  ],
  "compaction": {
    "auto": true
  },
  "permissions": [
    // ---- shell (V1 の permission.bash を V2 形式に移行) ----
    { "action": "shell", "resource": "*", "effect": "ask" },
    { "action": "shell", "resource": "git *", "effect": "allow" },
    { "action": "shell", "resource": "gh api *", "effect": "allow" },
    { "action": "shell", "resource": "gh pr *", "effect": "allow" },
    { "action": "shell", "resource": "gh issue *", "effect": "allow" },
    { "action": "shell", "resource": "rg *", "effect": "allow" },
    { "action": "shell", "resource": "grep *", "effect": "allow" },
    { "action": "shell", "resource": "find *", "effect": "allow" },
    { "action": "shell", "resource": "ls *", "effect": "allow" },
    { "action": "shell", "resource": "tree *", "effect": "allow" },
    { "action": "shell", "resource": "fd *", "effect": "allow" },
    { "action": "shell", "resource": "zoxide *", "effect": "allow" },
    { "action": "shell", "resource": "bat *", "effect": "allow" },
    // cat は .env などの直接読み出しベクターのため deny (read ツールで代替可能)
    { "action": "shell", "resource": "cat *", "effect": "deny" },
    { "action": "shell", "resource": "readlink *", "effect": "allow" },
    { "action": "shell", "resource": "command -v *", "effect": "allow" },
    { "action": "shell", "resource": "echo *", "effect": "allow" },
    { "action": "shell", "resource": "test *", "effect": "allow" },
    { "action": "shell", "resource": "make *", "effect": "allow" },
    { "action": "shell", "resource": "python3 *", "effect": "allow" },
    { "action": "shell", "resource": "shellcheck *", "effect": "allow" },
    { "action": "shell", "resource": "luac *", "effect": "allow" },
    { "action": "shell", "resource": "xargs *", "effect": "allow" },
    { "action": "shell", "resource": "afplay *", "effect": "allow" },
    { "action": "shell", "resource": "mv *", "effect": "allow" },
    { "action": "shell", "resource": "sd *", "effect": "allow" },
    { "action": "shell", "resource": "nvim *", "effect": "allow" },
    { "action": "shell", "resource": "git push --force *", "effect": "deny" },
    { "action": "shell", "resource": "git push -f *", "effect": "deny" },
    { "action": "shell", "resource": "git push * --force *", "effect": "deny" },
    { "action": "shell", "resource": "git push * -f *", "effect": "deny" },
    { "action": "shell", "resource": "rm -rf /*", "effect": "deny" },
    { "action": "shell", "resource": "rm -r /*", "effect": "deny" },
    { "action": "shell", "resource": "rm -rf ~*", "effect": "deny" },
    { "action": "shell", "resource": "rm -r ~*", "effect": "deny" },
    { "action": "shell", "resource": "rm -rf $HOME/*", "effect": "deny" },
    { "action": "shell", "resource": "rm -r $HOME/*", "effect": "deny" },
    { "action": "shell", "resource": "terraform apply", "effect": "deny" },
    { "action": "shell", "resource": "terraform apply *", "effect": "deny" },
    { "action": "shell", "resource": "terraform destroy", "effect": "deny" },
    { "action": "shell", "resource": "terraform destroy *", "effect": "deny" },
    { "action": "shell", "resource": "terraform taint", "effect": "deny" },
    { "action": "shell", "resource": "terraform taint *", "effect": "deny" },
    { "action": "shell", "resource": "terraform state rm", "effect": "deny" },
    { "action": "shell", "resource": "terraform state rm *", "effect": "deny" },
    { "action": "shell", "resource": "terraform force-unlock", "effect": "deny" },
    { "action": "shell", "resource": "terraform force-unlock *", "effect": "deny" },
    // ---- .env への shell 経由のアクセスを拒否 ----
    { "action": "shell", "resource": "* .env *", "effect": "deny" },
    { "action": "shell", "resource": "* .env*", "effect": "deny" },
    { "action": "shell", "resource": "* --env-file *", "effect": "deny" },
    { "action": "shell", "resource": "* --env-file=*", "effect": "deny" },
    // ---- read (V1 の permission.read を V2 形式に移行) ----
    { "action": "read", "resource": "*", "effect": "allow" },
    { "action": "read", "resource": "*.env", "effect": "deny" },
    { "action": "read", "resource": "*.env.*", "effect": "deny" },
    { "action": "read", "resource": "*.env.example", "effect": "allow" },
    { "action": "read", "resource": "*.envrc", "effect": "deny" },
    { "action": "read", "resource": "~/.ssh/**", "effect": "deny" },
    { "action": "read", "resource": "~/.aws/**", "effect": "deny" },
    // ---- edit / write / patch (V1 の permission.edit を V2 形式に移行) ----
    { "action": "edit", "resource": "*", "effect": "allow" },
    { "action": "edit", "resource": "*.env", "effect": "deny" },
    { "action": "edit", "resource": "*.env.*", "effect": "deny" },
    { "action": "edit", "resource": "*.env.example", "effect": "allow" },
    { "action": "edit", "resource": "*.envrc", "effect": "deny" },
    { "action": "edit", "resource": "*.git", "effect": "deny" },
    { "action": "edit", "resource": "*.git/*", "effect": "deny" },
    { "action": "edit", "resource": "*package-lock.json", "effect": "deny" },
    { "action": "edit", "resource": "*yarn.lock", "effect": "deny" },
    { "action": "edit", "resource": "*pnpm-lock.yaml", "effect": "deny" },
    { "action": "edit", "resource": "*Cargo.lock", "effect": "deny" },
    { "action": "edit", "resource": "*go.sum", "effect": "deny" },
    { "action": "edit", "resource": "*composer.lock", "effect": "deny" }
  ]
}
