{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode-go/deepseek-v4-pro",
  "small_model": "opencode-go/deepseek-v4-flash",
  "lsp": false,
  "autoupdate": true,
  "enabled_providers": ["opencode-go"],
  "compaction": {
    "auto": true
  },
  "permission": {
    "bash": {
      "*": "ask",
      "git *": "allow",
      "gh api *": "allow",
      "gh pr *": "allow",
      "gh issue *": "allow",
      "rg *": "allow",
      "grep *": "allow",
      "find *": "allow",
      "ls *": "allow",
      "tree *": "allow",
      "fd *": "allow",
      "zoxide *": "allow",
      "bat *": "allow",
      "cat *": "allow",
      "readlink *": "allow",
      "command -v *": "allow",
      "echo *": "allow",
      "test *": "allow",
      "make *": "allow",
      "python3 *": "allow",
      "shellcheck *": "allow",
      "luac *": "allow",
      "tmux *": "allow",
      "xargs *": "allow",
      "afplay *": "allow",
      "mv *": "allow",
      "sd *": "allow",
      "nvim *": "allow",
      "git push --force *": "deny",
      "git push -f *": "deny",
      "git push * --force *": "deny",
      "git push * -f *": "deny",
      "rm -rf /*": "deny",
      "rm -r /*": "deny",
      "rm -rf ~*": "deny",
      "rm -r ~*": "deny",
      "rm -rf $HOME/*": "deny",
      "rm -r $HOME/*": "deny",
      "terraform apply": "deny",
      "terraform apply *": "deny",
      "terraform destroy": "deny",
      "terraform destroy *": "deny",
      "terraform taint": "deny",
      "terraform taint *": "deny",
      "terraform state rm": "deny",
      "terraform state rm *": "deny",
      "terraform force-unlock": "deny",
      "terraform force-unlock *": "deny"
    },
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "*.envrc": "deny",
      "~/.ssh/**": "deny",
      "~/.aws/**": "deny"
    },
    "edit": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "*.envrc": "deny",
      "*.git": "deny",
      "*.git/*": "deny",
      "*package-lock.json": "deny",
      "*yarn.lock": "deny",
      "*pnpm-lock.yaml": "deny",
      "*Cargo.lock": "deny",
      "*go.sum": "deny",
      "*composer.lock": "deny"
    }
  }
}
