{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "gruvbox"
  },
  "scroll": {
    "acceleration": true
  },
  "attention": {
    "enabled": true,
    "sound": true,
    "volume": 0.4
  },
  "diffs": {
    "wrap": "word"
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": false,
    "thinking": "hide",
    "terminal": true,
    "markdown": "rendered"
  },
  "animations": true,
  "mouse": true,
  "cursor": {
    "style": "block",
    "blinking": true
  }
}
