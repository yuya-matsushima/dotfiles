{
  "id": "root",
  "cloned_from": {
    "name": "terminals",
    "version": "0.1.13"
  },
  "type": "column",
  "children": [
    {
      "id": "topbar",
      "type": "row",
      "size": {
        "px": 38
      },
      "resizable": false,
      "children": [
        {
          "id": "tabs",
          "type": "block",
          "size": {
            "weight": 1
          },
          "window_drag": true,
          "content": {
            "mod": "terminals-bar"
          }
        },
        {
          "id": "repo-toggle-bar",
          "type": "block",
          "size": {
            "px": 56
          },
          "window_drag": true,
          "content": {
            "mod": "repo-toggle"
          }
        }
      ]
    },
    {
      "id": "body",
      "type": "row",
      "gap": 8,
      "children": [
        {
          "id": "main",
          "type": "block",
          "size": {
            "weight": 1
          },
          "min": 0,
          "content": {
            "tab": "active",
            "pane": {
              "header": {
                "content": {
                  "mod": "terminals-pane"
                },
                "height": 38
              },
              "background": "#17191c",
              "border": {
                "width": 1,
                "color": "#24272b"
              },
              "focus": {
                "width": 1,
                "color": "#33363b"
              },
              "radius": 12,
              "gap": 8,
              "lone": true
            }
          }
        },
        {
          "id": "panel",
          "type": "column",
          "size": {
            "px": 368
          },
          "min": 280,
          "max": 900,
          "hidden": true,
          "children": [
            {
              "id": "panel-body",
              "type": "stack",
              "active": "repo-hub",
              "children": [
                {
                  "id": "repo-hub",
                  "type": "block",
                  "content": {
                    "mod": "repo-hub",
                    "props": {
                      "panel": true
                    }
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "background": "#131619",
  "padding": [
    6,
    6
  ],
  "theme": "graphite",
  "colors": {
    "accent": "#3b82f6",
    "background": "#131619",
    "border": "#25282c",
    "dim": "#8b8f95",
    "foreground": "#e8e9eb",
    "hover": "#ffffff0d",
    "muted": "#a9adb3",
    "raised": "#202225",
    "selection": "#264f78",
    "surface": "#17191c",
    "terminal_foreground": "#e6e7e9"
  },
  "font_size": 15,
  "gap": 8,
  "titlebar": "none",
  "traffic_lights": [
    16,
    18
  ]
}
