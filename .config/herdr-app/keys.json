{
  "global": {
    "ctrl-e c": "tab.new",
    "ctrl-e n": "tab.next",
    "ctrl-e ctrl-n": "tab.next",
    "ctrl-e ctrl-p": "tab.prev",
    "ctrl-e 1": "tab.select:1",
    "ctrl-e 2": "tab.select:2",
    "ctrl-e 3": "tab.select:3",
    "ctrl-e 4": "tab.select:4",
    "ctrl-e 5": "tab.select:5",
    "ctrl-e 6": "tab.select:6",
    "ctrl-e 7": "tab.select:7",
    "ctrl-e 8": "tab.select:8",
    "ctrl-e 9": "tab.select:9",
    "ctrl-e ,": "tab.rename",
    "ctrl-e &": "tab.close",

    "ctrl-e \\": "pane.split:right",
    "ctrl-e -": "pane.split:down",
    "ctrl-e h": "pane.go:left",
    "ctrl-e j": "pane.go:down",
    "ctrl-e k": "pane.go:up",
    "ctrl-e l": "pane.go:right",
    "ctrl-e z": "pane.close",
    "ctrl-e x": "pane.close",
    "ctrl-e m": "pane.zoom",

    "ctrl-e s": "mod.open:picker",
    "ctrl-e w": "mod.open:picker",
    "ctrl-e (": "space.prev",
    "ctrl-e )": "space.next",
    "ctrl-e $": "space.rename",
    "ctrl-e shift-n": "space.new",
    "ctrl-e shift-d": "space.close",

    "ctrl-e a": "agent.next",
    "ctrl-e shift-a": "agent.prev",

    "ctrl-e g": { "command": "tab.new", "args": { "name": "lazygit", "argv": ["lazygit"] } },

    "ctrl-e ?": "app.help",
    "ctrl-e :": "app.palette",
    "ctrl-e b": "layout.toggle:sidebar",
    "ctrl-e space": "layout.switch",

    "ctrl-tab": "tab.next",
    "ctrl-shift-tab": "tab.prev",
    "f2": "tab.rename",
    "shift-f2": "space.rename",

    "cmd-,": "app.settings",
    "ctrl-,": "app.settings",
    "cmd-=": "app.zoom_in",
    "cmd-+": "app.zoom_in",
    "cmd--": "app.zoom_out",
    "cmd-0": "app.zoom_reset",
    "ctrl-=": "app.zoom_in",
    "ctrl-+": "app.zoom_in",
    "ctrl--": "app.zoom_out",
    "ctrl-0": "app.zoom_reset",
    "ctrl-shift-g": "mod.open:repo-hub",

    "cmd-q": "app.quit",
    "cmd-h": "app.hide",
    "cmd-alt-h": "app.hide_others"
  },
  "terminal": {
    "ctrl-e ctrl-z": "send:\u0005",
    "ctrl-e p": "terminal.paste",
    "ctrl-e /": "terminal.search",

    "cmd-c": "terminal.copy",
    "cmd-v": "terminal.paste",
    "cmd-f": "terminal.search",
    "ctrl-shift-c": "terminal.copy",
    "ctrl-shift-v": "terminal.paste",
    "ctrl-shift-f": "terminal.search",
    "ctrl-insert": "terminal.copy",
    "shift-insert": "terminal.paste",
    "ctrl-v": "terminal.paste_image",

    "alt-left": "send:\u001bb",
    "alt-right": "send:\u001bf",
    "alt-backspace": "send:\u0017",
    "ctrl-left": "send:\u001bb",
    "ctrl-right": "send:\u001bf",
    "ctrl-backspace": "send:\u0017",
    "cmd-left": "send:\u0001",
    "cmd-right": "send:\u0005",
    "cmd-backspace": "send:\u0015"
  },
  "layout:hub": {
    "ctrl-shift-g": "repo-toggle.toggle",
    "ctrl-shift-r": "repo-hub.refresh"
  },
  "layout:workbench": {
    "ctrl-shift-g": "repo-toggle.toggle",
    "ctrl-shift-r": "repo-hub.refresh"
  }
}
