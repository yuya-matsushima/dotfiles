# Theme
theme = TokyoNight

# Font Configuration
font-family = UDEV Gothic 35NF
font-size = 12
font-thicken = true
font-thicken-strength = 200

# Window Configuration
background-opacity = 0.92
window-padding-x = 5
window-padding-y = 5
confirm-close-surface = false

# Cursor Configuration
cursor-style = block
cursor-style-blink = false
cursor-invert-fg-bg = true
cursor-opacity = 0.8

# Scrollback Configuration
scrollback-limit = 1000000

# Clipboard Configuration
copy-on-select = clipboard
clipboard-read = allow
clipboard-write = allow

# Terminal Configuration
term = xterm-ghostty

# macOS Specific Configuration
macos-option-as-alt = true
macos-titlebar-style = native
macos-titlebar-proxy-icon = hidden

# Shell Integration
shell-integration = detect

# Link Features
link-previews = true

# Keybindings
# タブ無効化: tmux ユーザーのためタブ生成ショートカット (Cmd+N / Cmd+T) を無効化
keybind = super+n=ignore
keybind = super+t=ignore
keybind = super+q=ignore
# 誤爆防止: close 系ショートカットを全て無効化し, window の close ボタンのみで閉じる
keybind = super+w=ignore
keybind = super+alt+w=ignore
keybind = super+shift+w=ignore
keybind = super+alt+shift+w=ignore

# Others
mouse-hide-while-typing = true
resize-overlay = never
