{
  "$schema": "https://raw.githubusercontent.com/gotgenes/pi-packages/main/packages/pi-permission-system/schemas/permissions.schema.json",
  "permissionReviewLog": true,
  "yoloMode": false,
  "permissionDialogKeys": {
    "approve": "1",
    "approveSession": "2",
    "approveSessionBoth": "3",
    "deny": "4",
    "denyWithReason": "5"
  },
  "permission": {
    "*": "ask",
    "read": "allow",
    "write": "allow",
    "edit": "allow",
    "find": "allow",
    "grep": "allow",
    "ls": "allow",
    "skill": "allow",
    "path": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "*.envrc": "deny",
      "~/.ssh/**": "deny",
      "~/.aws/**": "deny",
      "~/.gnupg/**": "deny",
      "~/.zsh/credentials.zsh": "deny",
      "**/.zsh/credentials.zsh": "deny",
      "~/.pi/agent/auth.json": "deny",
      "~/.local/share/opencode/**": "deny",
      "~/.claude/.credentials.json": "deny",
      "~/.codex/auth.json": "deny",
      "~/.config/gh/**": "deny",
      "**/.netrc": "deny",
      "**/*.pem": "deny",
      "**/*.key": "deny"
    },
    "path_write": {
      "*": "allow",
      "*/.git": "deny",
      "*/.git/*": "deny",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "*.envrc": "deny",
      "~/.ssh/**": "deny",
      "~/.aws/**": "deny",
      "~/.gnupg/**": "deny",
      "~/.zsh/credentials.zsh": "deny",
      "**/.zsh/credentials.zsh": "deny",
      "~/.pi/agent/auth.json": "deny",
      "~/.local/share/opencode/**": "deny",
      "~/.claude/.credentials.json": "deny",
      "~/.codex/auth.json": "deny",
      "~/.config/gh/**": "deny",
      "**/.netrc": "deny",
      "**/*.pem": "deny",
      "**/*.key": "deny",
      "*/package-lock.json": "deny",
      "*/yarn.lock": "deny",
      "*/pnpm-lock.yaml": "deny",
      "*/Cargo.lock": "deny",
      "*/go.sum": "deny",
      "*/composer.lock": "deny"
    },
    "external_directory": "ask",
    "bash": {
      "*": "ask",
      "git *": "allow",
      "gh api *": "allow",
      "gh pr *": "allow",
      "gh issue *": "allow",
      "rg *": "allow",
      "grep *": "allow",
      "find *": "allow",
      "ls *": "allow",
      "tree *": "allow",
      "fd *": "allow",
      "zoxide *": "allow",
      "bat *": "allow",
      "readlink *": "allow",
      "command -v *": "allow",
      "echo *": "allow",
      "test *": "allow",
      "make *": "allow",
      "python3 *": "ask",
      "shellcheck *": "allow",
      "luac *": "allow",
      "xargs *": "ask",
      "afplay *": "allow",
      "mv *": "ask",
      "sd *": "ask",
      "nvim *": "ask",
      "cat *": {
        "action": "deny",
        "reason": "cat は .env などの直接読み出しベクターのためブロックします。read ツールを使ってください。"
      },
      "git reset --hard": "deny",
      "git reset --hard *": "deny",
      "git clean -*f*": "deny",
      "git checkout -- .": "deny",
      "git restore .": "deny",
      "git restore -- .": "deny",
      "git push --force *": "deny",
      "git push -f *": "deny",
      "git push * --force *": "deny",
      "git push * -f *": "deny",
      "gh api * -X DELETE *": "deny",
      "gh api * --method DELETE *": "deny",
      "gh api * -XDELETE *": "deny",
      "rm -rf /*": "deny",
      "rm -r /*": "deny",
      "rm -rf ~*": "deny",
      "rm -r ~*": "deny",
      "rm -rf $HOME/*": "deny",
      "rm -r $HOME/*": "deny",
      "terraform apply": "deny",
      "terraform apply *": "deny",
      "terraform destroy": "deny",
      "terraform destroy *": "deny",
      "terraform taint": "deny",
      "terraform taint *": "deny",
      "terraform state rm": "deny",
      "terraform state rm *": "deny",
      "terraform force-unlock": "deny",
      "terraform force-unlock *": "deny"
    }
  }
}
