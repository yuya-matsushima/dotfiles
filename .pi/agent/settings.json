{
  "$schema": "https://pi.dev/schemas/settings.schema.json",
  "defaultProvider": "opencode-go",
  "defaultModel": "gpt-6-luna",
  "defaultThinkingLevel": "medium",
  "enabledModels": [
    "opencode-go/gpt-6-luna",
    "opencode-go/deepseek-v4.1-flash",
    "opencode-go/claude-haiku-5-5"
  ],
  "defaultTools": [
    "+grep",
    "+find",
    "+ls"
  ],
  "packages": [
    "npm:pi-vim",
    "npm:pi-mcp-adapter",
    "npm:pi-web-search",
    "npm:pi-subagents",
    "npm:@gotgenes/pi-permission-system@40.2.0",
    "npm:cc-safety-net@2.6.10",
    "npm:@narumitw/pi-plan-mode",
    "npm:@narumitw/pi-usage",
    "npm:@narumitw/pi-btw",
    {
      "source": "npm:pi-code",
      "extensions": [
        "!extensions/subagent/**",
        "!extensions/plan-mode/**",
        "!extensions/settings-flags.ts",
        "!extensions/web.ts",
        "!extensions/hooks/**",
        "!extensions/mcp/**"
      ]
    },
    "npm:pi-lens"
  ],
  "subagents": {
    "defaultProvider": "opencode-go",
    "defaultModel": "gpt-6-luna"
  },
  "theme": "omarchy-system",
  "extensions": [
    "-builtin:mcp"
  ]
}
