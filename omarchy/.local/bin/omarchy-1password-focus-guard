#!/bin/sh
# 1Password の SSH キー承認ダイアログ (「1Password アクセスリクエスト」) が
# 表示されている間, フォーカスをそのダイアログに固定する。
#
# ダイアログはメインウィンドウと同じ class (com.onepassword.OnePassword) で
# title も "1Password" だが, 小さな floating ウィンドウとして開く。
# Quick Access (title "1Password", floating) はより大きいため, サイズで区別する。
#
# 承認 / 拒否 / タイムアウトでダイアログが閉じれば自動的に解除される。
# 停止: pkill -f omarchy-1password-focus-guard

SOCKET="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/hypr/$HYPRLAND_INSTANCE_SIGNATURE/.socket2.sock"
TAG=omarchy-1password-focus-guard

log() {
    logger -t "$TAG" "$*" 2>/dev/null || true
}

focus_address() {
    hyprctl dispatch "hl.dsp.focus({ window = \"address:$1\" })" >/dev/null 2>&1
}

# SSH 承認ダイアログを "focusHistoryID<TAB>address" で出力する。
approval_windows() {
    hyprctl clients -j 2>/dev/null | jq -r '
        .[] |
        select(.class == "com.onepassword.OnePassword") |
        select(.title == "1Password" and .mapped == true and .hidden != true and .floating == true) |
        select(.size[0] <= 650 and .size[1] <= 550) |
        "\(.focusHistoryID)\t\(.address)"
    ' 2>/dev/null
}

pin_focus() {
    dialogs=$(approval_windows)
    [ -n "$dialogs" ] || return 0

    active=$(hyprctl activewindow -j 2>/dev/null | jq -r '.address // empty')
    if [ -n "$active" ] && printf '%s\n' "$dialogs" | cut -f2 | grep -qx "$active"; then
        return 0
    fi

    target=$(printf '%s\n' "$dialogs" | sort -n | head -n 1 | cut -f2)
    [ -n "$target" ] || return 0

    focus_address "$target"
    log "focused SSH approval dialog $target"
}

command -v socat >/dev/null 2>&1 || {
    log "socat not found"
    exit 1
}

log "started"

# 起動時点で既にダイアログが開いている場合に備える。
pin_focus

while :; do
    socat -U - "UNIX-CONNECT:$SOCKET" 2>/dev/null |
        while IFS= read -r line; do
            case ${line%%>>*} in
                activewindow | openwindow | closewindow | windowtitle | movewindow | workspace | focusedmon)
                    pin_focus
                    ;;
            esac
        done

    sleep 1
done
