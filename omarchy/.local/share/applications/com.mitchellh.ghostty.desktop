[Desktop Entry]
Version=1.0
Name=Ghostty
Type=Application
Comment=A terminal emulator
TryExec=/usr/bin/ghostty
# Ghostty 1.3.x (GTK4 / Wayland) は fcitx5 の日本語入力で確定が失われる
# (ghostty-org/ghostty#12679)。fcitx5 の GTK IM モジュールを明示して回避する。
# DBusActivatable=true のままだと D-Bus サービス
# (/usr/share/dbus-1/services/com.mitchellh.ghostty.service) が環境変数なしで
# /usr/bin/ghostty を起動してしまうため false にする。
Exec=/usr/bin/env GTK_IM_MODULE=fcitx /usr/bin/ghostty --gtk-single-instance=true
Icon=com.mitchellh.ghostty
Categories=System;TerminalEmulator;
Keywords=terminal;tty;pty
StartupNotify=true
StartupWMClass=com.mitchellh.ghostty
Terminal=false
Actions=new-window;
X-GNOME-UsesNotifications=true
X-TerminalArgExec=-e
X-TerminalArgTitle=--title=
X-TerminalArgAppId=--class=
X-TerminalArgDir=--working-directory=
X-TerminalArgHold=--wait-after-command
DBusActivatable=false
X-KDE-Shortcuts=Ctrl+Alt+T

[Desktop Action new-window]
Name=New Window
Exec=/usr/bin/env GTK_IM_MODULE=fcitx /usr/bin/ghostty --gtk-single-instance=true
