{
  "cleanupPeriodDays": 180,
  "env": {
    "BASH_DEFAULT_TIMEOUT_MS": "600000",
    "BASH_MAX_TIMEOUT_MS": "600000",
    "CLAUDE_CODE_SUBAGENT_MODEL": "claude-sonnet-5-5",
    "DISABLE_AUTOUPDATER": "1"
  },
  "permissions": {
    "allow": [
      "Bash(rg:*)",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(ls:*)",
      "Bash(git *)",
      "Bash(mv:*)",
      "Bash(gh api *)",
      "Bash(gh pr *)",
      "Bash(gh issue *)",
      "Bash(afplay:*)",
      "Bash(echo:*)",
      "WebFetch(domain:mise.jdx.dev)",
      "Bash(webdata:*)",
      "Bash(shellcheck:*)",
      "Bash(cat:*)",
      "Bash(test:*)",
      "Bash(nvim:*)",
      "Bash(luac:*)",
      "WebSearch",
      "WebFetch",
      "Bash(tree:*)",
      "Bash(tmux *)",
      "Bash(codex --help:*)",
      "Bash(readlink:*)",
      "Bash(make:*)",
      "Bash(tmux capture-pane:*)",
      "Bash(command -v:*)",
      "Bash(tmux source-file:*)",
      "Bash(tmux list-keys:*)",
      "Bash(sd:*)",
      "Bash(bat:*)",
      "Bash(fd:*)",
      "Bash(zoxide:*)",
      "Bash(yazi:*)",
      "Bash(codex exec:*)"
    ],
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(rm -rf /*)",
      "Bash(rm -r /*)",
      "Bash(rm -rf ~*)",
      "Bash(rm -r ~*)",
      "Bash(rm -rf $HOME/*)",
      "Bash(rm -r $HOME/*)",
      "Bash(terraform apply)",
      "Bash(terraform apply *)",
      "Bash(terraform destroy)",
      "Bash(terraform destroy *)",
      "Bash(terraform taint)",
      "Bash(terraform taint *)",
      "Bash(terraform state rm)",
      "Bash(terraform state rm *)",
      "Bash(terraform force-unlock)",
      "Bash(terraform force-unlock *)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus",
  "fallbackModel": [
    "sonnet"
  ],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "sh ~/.claude/hooks/guard-protected-files.sh",
            "timeout": 3
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh ~/.claude/hooks/guard-force-push.sh",
            "timeout": 3
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh ~/.agents/hooks/notify-sound.sh",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "sh ~/.claude/statusline.sh"
  },
  "enabledPlugins": {},
  "extraKnownMarketplaces": {},
  "language": "Japanese",
  "sandbox": {
    "excludedCommands": [
      "codex:*",
      "gh:*"
    ]
  },
  "effortLevel": "high",
  "modelSettings": {
    "claude-opus-5-5": {
      "autoCompactWindow": 400000
    }
  },
  "pluginConfigs": {},
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "theme": "dark-ansi",
  "editorMode": "vim",
  "preferredNotifChannel": "ghostty",
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true
}
