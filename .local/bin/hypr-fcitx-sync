#!/usr/bin/env python3
"""Keep fcitx5 in sync with the focused Hyprland window.

Hyprland のイベントソケット (.socket2.sock) を購読し, ウィンドウのフォーカスが
変わるたびに fcitx5 の入力状態を送り直す。

背景: Hyprland の zwp_input_method_v2 連携では, fcitx5 がアプリ切替に正しく
追従できず, 特定のアプリで入力切替が効かなくなることがある。本スクリプトは
フォーカス切替のたびに外から状態を同期し直すことで, その取りこぼしを補正する。

設定 (: ~/.config/hypr/fcitx-sync.conf, 無ければ既定値で動作):
    default = keep      # アプリ未指定時の挙動: keep | ja | en
    heal    = cycle     # 同期方法: cycle | reassert | none
    firefox = ja        # ウィンドウ CLASS ごとの指定
    Alacritty = en

  keep      現在の状態を維持する (方針を押し付けず同期だけ行う)
  cycle     有効なら一度 off -> on して fcitx5 を強制的に再活性化する
            (取りこぼした活性化を復活させる本命の対策)
  reassert  現在の状態をそのまま再送する (off にできない場合の安全側)
  none      モードの適用のみ (再活性化はしない)

状態: $XDG_STATE_HOME/hypr-fcitx-sync/state.json  (アプリごとの直前状態)
ログ: $XDG_STATE_HOME/hypr-fcitx-sync/log
"""

from __future__ import annotations

import json
import os
import signal
import socket
import subprocess
import sys
import time

HOME = os.path.expanduser("~")
STATE_HOME = os.environ.get("XDG_STATE_HOME", os.path.join(HOME, ".local", "state"))
CONFIG_HOME = os.environ.get("XDG_CONFIG_HOME", os.path.join(HOME, ".config"))

STATE_DIR = os.path.join(STATE_HOME, "hypr-fcitx-sync")
STATE_FILE = os.path.join(STATE_DIR, "state.json")
LOG_FILE = os.path.join(STATE_DIR, "log")
CONFIG_FILE = os.path.join(CONFIG_HOME, "hypr", "fcitx-sync.conf")

FCITX_REMOTE = "fcitx5-remote"
VALID_MODES = ("ja", "en", "keep")
VALID_HEAL = ("cycle", "reassert", "none")

_running = True


def log(message: str) -> None:
    try:
        os.makedirs(STATE_DIR, exist_ok=True)
        with open(LOG_FILE, "a", encoding="utf-8") as handle:
            handle.write(f"{time.strftime('%Y-%m-%d %H:%M:%S')} {message}\n")
    except OSError:
        pass


def read_config() -> tuple[str, str, dict[str, str]]:
    default = "keep"
    heal = "cycle"
    rules: dict[str, str] = {}
    try:
        with open(CONFIG_FILE, encoding="utf-8") as handle:
            for raw in handle:
                line = raw.split("#", 1)[0].strip()
                if not line or "=" not in line:
                    continue
                key, value = (part.strip() for part in line.split("=", 1))
                value = value.lower()
                if key == "default" and value in VALID_MODES:
                    default = value
                elif key == "heal" and value in VALID_HEAL:
                    heal = value
                elif value in VALID_MODES:
                    rules[key] = value
    except FileNotFoundError:
        pass
    except OSError as exc:
        log(f"config error: {exc}")
    return default, heal, rules


def load_state() -> dict[str, str]:
    try:
        with open(STATE_FILE, encoding="utf-8") as handle:
            data = json.load(handle)
            return {str(k): str(v) for k, v in data.items()}
    except (OSError, ValueError):
        return {}


def save_state(state: dict[str, str]) -> None:
    try:
        os.makedirs(STATE_DIR, exist_ok=True)
        tmp = STATE_FILE + ".tmp"
        with open(tmp, "w", encoding="utf-8") as handle:
            json.dump(state, handle)
        os.replace(tmp, STATE_FILE)
    except OSError as exc:
        log(f"state save error: {exc}")


def fcitx_state() -> int | None:
    """fcitx5 の状態: 0/1 = 無効, 2 = 有効。取得不可なら None。"""
    try:
        out = subprocess.run(
            [FCITX_REMOTE], capture_output=True, text=True, timeout=2
        ).stdout.strip()
        return int(out)
    except (OSError, ValueError, subprocess.SubprocessError):
        return None


def mode_of(state: int | None) -> str | None:
    if state is None:
        return None
    return "ja" if state == 2 else "en"


def apply(mode: str, heal: str) -> str:
    """fcitx5 にモードを適用する。heal に応じて再活性化を行う。"""
    state = fcitx_state()
    if state is None:
        return "fcitx-unavailable"
    if mode == "keep":
        mode = mode_of(state) or "en"

    args: list[str] = []
    if heal == "cycle" and state == 2 and mode == "ja":
        # 一度 off にしてから on にし直すことで, 取りこぼした活性化を復活させる。
        args.append("-c")
    args.append("-o" if mode == "ja" else "-c")

    try:
        for arg in args:
            subprocess.run([FCITX_REMOTE, arg], timeout=2, check=False)
        return f"{FCITX_REMOTE} {' '.join(args)}"
    except (OSError, subprocess.SubprocessError) as exc:
        return f"error:{exc}"


def socket_path() -> str:
    runtime = os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")
    signature = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE", "")
    return os.path.join(runtime, "hypr", signature, ".socket2.sock")


def handle_event(line: str, ctx: dict) -> None:
    event, _, payload = line.partition(">>")
    if event != "activewindow":
        return

    window_class = payload.split(",", 1)[0].strip()
    if not window_class:
        # デスクトップ (ウィンドウ無し) にフォーカスが戻った場合は何もしない。
        return

    previous = ctx["current"]
    if previous is not None:
        prev_mode = mode_of(fcitx_state())
        if prev_mode is not None:
            ctx["state"][previous] = prev_mode

    desired = ctx["rules"].get(
        window_class, ctx["state"].get(window_class, ctx["default"])
    )
    applied = apply(desired, ctx["heal"])
    log(
        f"focus {previous!r} -> {window_class!r} desired={desired} "
        f"heal={ctx['heal']} applied={applied}"
    )
    ctx["state"][window_class] = mode_of(fcitx_state()) or desired
    save_state(ctx["state"])
    ctx["current"] = window_class


def run() -> None:
    default, heal, rules = read_config()
    ctx = {
        "default": default,
        "heal": heal,
        "rules": rules,
        "state": load_state(),
        "current": None,
    }
    log(f"start pid={os.getpid()} default={default} heal={heal} rules={rules}")

    buffer = b""
    sock = None
    while _running:
        try:
            sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
            sock.connect(socket_path())
            sock.settimeout(1.0)
            log("connected")
            buffer = b""
            while _running:
                try:
                    chunk = sock.recv(4096)
                except socket.timeout:
                    continue
                if not chunk:
                    break
                buffer += chunk
                while b"\n" in buffer:
                    line, buffer = buffer.split(b"\n", 1)
                    handle_event(line.decode("utf-8", "replace"), ctx)
        except OSError as exc:
            if _running:
                log(f"socket error: {exc}; reconnect in 2s")
                time.sleep(2)
        finally:
            if sock is not None:
                try:
                    sock.close()
                except OSError:
                    pass
                sock = None


def _stop(*_args) -> None:
    global _running
    _running = False


def main() -> int:
    signal.signal(signal.SIGTERM, _stop)
    signal.signal(signal.SIGINT, _stop)
    run()
    log("stop")
    return 0


if __name__ == "__main__":
    sys.exit(main())
