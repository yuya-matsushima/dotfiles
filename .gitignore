.vim/autoload/plug.vim
.vim/autoload/plug.vim.old
.vim/plugged/*
.vim/sessions
.vim/.netrwhist
.config/nvim/autoload/plug.vim
.config/nvim/autoload/plug.vim.old
.config/nvim/plugged/*
.zsh/caches/*
.zsh/git-prompt.zsh

*.dylib
.hammerspoon/hs/libspaces*dylib.dSYM/*

# Coding Agent
.claude/*
!.claude/hooks/
!.claude/CLAUDE.md
!.claude/settings.example.json
!.claude/statusline.sh
.antigravitycli/
.config/opencode/service.json
# agents are distributed from personal-skills via `make install-agents`
.config/opencode/agents/
# Pi: 設定は $HOME へ symlink, 実行時データは管理対象外
/.pi/*
!/.pi/agent/
/.pi/agent/*
!/.pi/agent/settings.json
!/.pi/agent/keybindings.json
# グローバル指示 (日本語応答などの方針) は管理対象
!/.pi/agent/AGENTS.md
# 拡張 (tmux status / force-push guard / 権限ポリシー) は管理対象
!/.pi/agent/extensions/
/.pi/agent/extensions/*
!/.pi/agent/extensions/tmux-status.ts
!/.pi/agent/extensions/guard-force-push.ts
!/.pi/agent/extensions/pi-permission-system/
/.pi/agent/extensions/pi-permission-system/*
!/.pi/agent/extensions/pi-permission-system/config.json

# webdata-node dependencies
.zsh/bin/webdata-node/node_modules/

# pnpm store
.pnpm-store/

# webdata output directories
**/output/
**/captures/
**/markdown/
webdata-output/

# tmux-agent-sidebar (~/.tmux is a symlink to .tmux/, cloned by make tmux_plugin)
.tmux/plugins/
.config/opencode/plugins/tmux-agent-sidebar.js

# Working directories
tmp/
feature/

# Python
__pycache__/
*.py[cod]
